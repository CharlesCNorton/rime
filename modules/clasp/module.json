  "registers": [
    {
      "offset": "0x000-0x01C",
      "name": "ACQUIRE[0..7]",
      "access": "r",
      "desc": "atomic test-and-set, returns prior value"
    },
    {
      "offset": "0x020-0x03C",
      "name": "RELEASE[0..7]",
      "access": "w",
      "desc": "clear the slot (any data)"
    },
