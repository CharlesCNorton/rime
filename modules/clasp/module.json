{
  "name": "clasp",
  "top_module": "clasp",
  "description": "CLASP: Contested Lock with Atomic Set Protocol \u2014 8-slot hardware mutex with atomic test-and-set",
  "resources": {
    "luts": 43,
    "brams": 0,
    "multipliers": 0
  },
  "interfaces": {
    "provides": [
      "register"
