      "offset": "0x040",
      "name": "STATE",
      "access": "r",
      "desc": "current 8-bit state of all slots"
    },
    {
      "offset": "0x044",
      "name": "CONTROL",
      "access": "w",
      "desc": "bit 0 = clear all"
    },
    {
      "offset": "0x048",
      "name": "OWNERS",
      "access": "r",
      "desc": "same as STATE (alias)"
    }
  ]
