// Generated XOR topology masks: 4 topologies x 8 channels x 192 bits
// Each mask selects which rings contribute to that channel via XOR.

localparam [191:0] TOPO0_CH0 = {32'h01081200, 32'h28A00000, 32'h00040404, 32'h08410024, 32'h80815800, 32'h00010200};
localparam [191:0] TOPO0_CH1 = {32'h12102000, 32'h04410040, 32'h04098800, 32'h80000600, 32'h0C100010, 32'h00202081};
localparam [191:0] TOPO0_CH2 = {32'h00020850, 32'h41008080, 32'h80C06010, 32'h01000100, 32'h01048402, 32'h10041000};
localparam [191:0] TOPO0_CH3 = {32'h48010084, 32'h00003400, 32'h43001020, 32'h04084000, 32'h20022000, 32'h04800940};
localparam [191:0] TOPO0_CH4 = {32'h84000102, 32'h80104008, 32'h08000000, 32'h0032A081, 32'h42000001, 32'h0100440A};
localparam [191:0] TOPO0_CH5 = {32'h00000421, 32'h00080A03, 32'h20120081, 32'h70000000, 32'h10000208, 32'h204A0010};
localparam [191:0] TOPO0_CH6 = {32'h20E08000, 32'h10000120, 32'h00200248, 32'h00801042, 32'h00200120, 32'hC0108004};
localparam [191:0] TOPO0_CH7 = {32'h00044008, 32'h02060014, 32'h10000102, 32'h02040818, 32'h004800C4, 32'h0A000020};

localparam [191:0] TOPO1_CH0 = {32'h048C0008, 32'h22000008, 32'h88001000, 32'h80105040, 32'h22011004, 32'h20080040};
localparam [191:0] TOPO1_CH1 = {32'h02004000, 32'h40D02001, 32'h00302001, 32'h00230100, 32'h00408228, 32'h00240001};
localparam [191:0] TOPO1_CH2 = {32'h00222030, 32'h88000200, 32'h03010020, 32'h20880200, 32'h11204040, 32'h00000E00};
localparam [191:0] TOPO1_CH3 = {32'h00000200, 32'h10221442, 32'h00044044, 32'h04040024, 32'h0C000400, 32'h86020002};
localparam [191:0] TOPO1_CH4 = {32'hC0110400, 32'h000C4000, 32'h00000A1A, 32'h1A000000, 32'h00100810, 32'h40019080};
localparam [191:0] TOPO1_CH5 = {32'h10401100, 32'h04008084, 32'h10880100, 32'h41000081, 32'hC0042100, 32'h10100100};
localparam [191:0] TOPO1_CH6 = {32'h28008041, 32'h00000920, 32'h40020080, 32'h00402412, 32'h00080082, 32'h09804004};
localparam [191:0] TOPO1_CH7 = {32'h01000886, 32'h01010010, 32'h24408400, 32'h00008808, 32'h00820001, 32'h00402038};

localparam [191:0] TOPO2_CH0 = {32'h10010004, 32'h82060010, 32'h08000280, 32'h000C1082, 32'h00401020, 32'h010A0041};
localparam [191:0] TOPO2_CH1 = {32'h00005100, 32'h40013080, 32'h00020521, 32'h24000040, 32'h24000300, 32'h00403020};
localparam [191:0] TOPO2_CH2 = {32'h22040C40, 32'h00000003, 32'h40200000, 32'h58022200, 32'h130C0000, 32'h04018000};
localparam [191:0] TOPO2_CH3 = {32'h48000200, 32'h19100020, 32'h0010A040, 32'h00014404, 32'h08810088, 32'h12000008};
localparam [191:0] TOPO2_CH4 = {32'h0080A083, 32'h04000100, 32'h15004000, 32'h02000118, 32'h00120804, 32'h08004410};
localparam [191:0] TOPO2_CH5 = {32'h00400038, 32'h0020C008, 32'h8004001C, 32'h01808000, 32'h4000A000, 32'h60900200};
localparam [191:0] TOPO2_CH6 = {32'h01000000, 32'h00880E44, 32'h00490002, 32'h00300820, 32'h00004452, 32'h00040104};
localparam [191:0] TOPO2_CH7 = {32'h843A0000, 32'h20400000, 32'h22801800, 32'h80400001, 32'h80200001, 32'h80200882};

localparam [191:0] TOPO3_CH0 = {32'h00000819, 32'h40009020, 32'h10400080, 32'h12201001, 32'h002000C1, 32'h00206040};
localparam [191:0] TOPO3_CH1 = {32'h48481080, 32'h0A000000, 32'h09050008, 32'h00040140, 32'h06020600, 32'h81000100};
localparam [191:0] TOPO3_CH2 = {32'h34010402, 32'h00040001, 32'h06008442, 32'h00020080, 32'h00000100, 32'h22031880};
localparam [191:0] TOPO3_CH3 = {32'h00028000, 32'h10120302, 32'h00200001, 32'h0D000034, 32'h80011030, 32'h10000220};
localparam [191:0] TOPO3_CH4 = {32'h01100144, 32'h00002044, 32'h00005000, 32'h00590C00, 32'h00802806, 32'h48100000};
localparam [191:0] TOPO3_CH5 = {32'h00242200, 32'h05000090, 32'hC0080010, 32'h2000020A, 32'h08048000, 32'h04880006};
localparam [191:0] TOPO3_CH6 = {32'h00800000, 32'hA0C84400, 32'h00902104, 32'h0080C000, 32'h70004008, 32'h00440008};
localparam [191:0] TOPO3_CH7 = {32'h82004020, 32'h00210808, 32'h20020A20, 32'hC0002000, 32'h01580000, 32'h00008411};

// Channel XOR collapse: select mask by active_topo, XOR with ring_sampled
logic [NUM_CH-1:0] channel_bits;
always_comb begin
    case (active_topo)
        2'd0: channel_bits[0] = ^(ring_sampled & TOPO0_CH0);
        2'd1: channel_bits[0] = ^(ring_sampled & TOPO1_CH0);
        2'd2: channel_bits[0] = ^(ring_sampled & TOPO2_CH0);
        2'd3: channel_bits[0] = ^(ring_sampled & TOPO3_CH0);
    endcase
    case (active_topo)
        2'd0: channel_bits[1] = ^(ring_sampled & TOPO0_CH1);
        2'd1: channel_bits[1] = ^(ring_sampled & TOPO1_CH1);
        2'd2: channel_bits[1] = ^(ring_sampled & TOPO2_CH1);
        2'd3: channel_bits[1] = ^(ring_sampled & TOPO3_CH1);
    endcase
    case (active_topo)
        2'd0: channel_bits[2] = ^(ring_sampled & TOPO0_CH2);
        2'd1: channel_bits[2] = ^(ring_sampled & TOPO1_CH2);
        2'd2: channel_bits[2] = ^(ring_sampled & TOPO2_CH2);
        2'd3: channel_bits[2] = ^(ring_sampled & TOPO3_CH2);
    endcase
    case (active_topo)
        2'd0: channel_bits[3] = ^(ring_sampled & TOPO0_CH3);
        2'd1: channel_bits[3] = ^(ring_sampled & TOPO1_CH3);
        2'd2: channel_bits[3] = ^(ring_sampled & TOPO2_CH3);
        2'd3: channel_bits[3] = ^(ring_sampled & TOPO3_CH3);
    endcase
    case (active_topo)
        2'd0: channel_bits[4] = ^(ring_sampled & TOPO0_CH4);
        2'd1: channel_bits[4] = ^(ring_sampled & TOPO1_CH4);
        2'd2: channel_bits[4] = ^(ring_sampled & TOPO2_CH4);
        2'd3: channel_bits[4] = ^(ring_sampled & TOPO3_CH4);
    endcase
    case (active_topo)
        2'd0: channel_bits[5] = ^(ring_sampled & TOPO0_CH5);
        2'd1: channel_bits[5] = ^(ring_sampled & TOPO1_CH5);
        2'd2: channel_bits[5] = ^(ring_sampled & TOPO2_CH5);
        2'd3: channel_bits[5] = ^(ring_sampled & TOPO3_CH5);
    endcase
    case (active_topo)
        2'd0: channel_bits[6] = ^(ring_sampled & TOPO0_CH6);
        2'd1: channel_bits[6] = ^(ring_sampled & TOPO1_CH6);
        2'd2: channel_bits[6] = ^(ring_sampled & TOPO2_CH6);
        2'd3: channel_bits[6] = ^(ring_sampled & TOPO3_CH6);
    endcase
    case (active_topo)
        2'd0: channel_bits[7] = ^(ring_sampled & TOPO0_CH7);
        2'd1: channel_bits[7] = ^(ring_sampled & TOPO1_CH7);
        2'd2: channel_bits[7] = ^(ring_sampled & TOPO2_CH7);
        2'd3: channel_bits[7] = ^(ring_sampled & TOPO3_CH7);
    endcase
end
