      "access": "r",
      "desc": "channel 1 accumulator"
    },
    {
      "offset": "0x010",
      "name": "ACC2",
      "access": "r",
      "desc": "channel 2 accumulator"
    },
    {
      "offset": "0x014",
      "name": "ACC3",
      "access": "r",
      "desc": "channel 3 accumulator"
    },
    {
      "offset": "0x018",
      "name": "STATUS",
      "access": "r",
      "desc": "bit 0 = done (all channels idle)"
    },
    {
      "offset": "0x01C",
