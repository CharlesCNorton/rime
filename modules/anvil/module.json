{
  "name": "anvil",
  "version": "0.1.0",
  "description": "ANVIL: hardware CRC-32 accelerator (IEEE 802.3 polynomial).",
  "resources": {
    "luts": 107,
    "brams": 0,
    "multipliers": 0
  },
  "interfaces": {
    "requires": [
      "cpu_bus",
      "clock",
      "reset"
    ],
    "provides": [
      "crc32"
    ]
  },
  "top_module": "anvil",
  "registers": [
    {
      "offset": "0x000",
      "name": "DATA",
      "access": "w",
      "desc": "feed one byte (bits [7:0]), CRC updates immediately"
    },
    {
      "offset": "0x004",
      "name": "CRC",
      "access": "r",
      "desc": "current CRC-32 value (inverted, ready to use)"
    },
    {
      "offset": "0x008",
      "name": "CONTROL",
      "access": "w",
      "desc": "bit 0 = reset CRC to 0xFFFFFFFF"
    },
    {
      "offset": "0x00C",
      "name": "RAW",
      "access": "r",
      "desc": "raw (non-inverted) CRC state"
    },
    {
      "offset": "0x010",
      "name": "COUNT",
      "access": "r",
      "desc": "number of bytes fed since last reset"
    }
  ]
}
