{
  "name": "dice",
  "version": "0.1.0",
  "description": "DICE: Density-Inferred Computation Engine. Stochastic computing matrix.",
  "resources": {
    "luts": 129,
    "brams": 0,
    "multipliers": 0
  },
  "interfaces": {
    "requires": [
      "cpu_bus",
      "clock",
      "reset"
    ],
    "provides": [
      "stochastic_alu"
    ]
  },
  "top_module": "dice",
  "registers": [
    {
      "offset": "0x000",
      "name": "OP_A",
      "access": "w",
      "desc": "operand A as 8-bit probability (0-255 = 0.0-1.0)"
    },
    {
      "offset": "0x004",
      "name": "OP_B",
      "access": "w",
      "desc": "operand B as 8-bit probability"
    },
    {
      "offset": "0x008",
      "name": "RESULT",
      "access": "r",
      "desc": "stochastic multiply result (A * B / 256)"
    },
    {
      "offset": "0x00C",
      "name": "CONTROL",
      "access": "w",
      "desc": "bit 0 = start computation, bit 1 = reset"
    },
    {
      "offset": "0x010",
      "name": "STATUS",
      "access": "r",
      "desc": "bit 0 = done"
    },
    {
      "offset": "0x014",
      "name": "ADD_RES",
      "access": "r",
      "desc": "stochastic addition result ((A + B) / 2)"
    },
    {
      "offset": "0x018",
      "name": "CYCLES",
      "access": "r",
      "desc": "number of stream cycles used (precision indicator)"
    }
  ]
}
